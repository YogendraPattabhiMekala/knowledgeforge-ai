# Keep host environments, credentials, runtime state and test output out of ALL build stages.
.git
**/node_modules
**/.next
**/.venv
**/venv
**/__pycache__
**/*.py[cod]
**/*.tsbuildinfo
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.cache
**/.coverage*
**/coverage
**/htmlcov
**/test-results
**/playwright-report
**/blob-report
**/artifacts
**/validation-output
**/uploads
**/.data
**/*.db
**/*.db-*
**/*.sqlite*
**/*.log
**/*.zip
**/*.tar
**/*.tar.gz
**/*.sql
**/*.dump
**/.env
**/.env.*
!/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/credentials*.json
**/secrets*.json
**/.terraform
**/*.tfstate*
**/*.tfvars
**/.DS_Store
**/Thumbs.db
