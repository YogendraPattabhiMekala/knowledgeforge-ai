# Copy to .env in repository root. Docker Compose reads this file.
POSTGRES_PASSWORD=local-development-change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=local-storage-change-me
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Compose supplies the database, Redis and S3 endpoints internally.
ENVIRONMENT=development
SECURE_COOKIES=false
PUBLIC_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.test

# Leave empty for local MinIO without KMS. Production requires AES256 or aws:kms.
S3_SERVER_SIDE_ENCRYPTION=

# Answer evidence gate: unique topical-term coverage, not confidence.
RELEVANCE_MIN_COVERAGE=0.8
RELEVANCE_MIN_MATCHES=2
